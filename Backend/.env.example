# Copia este archivo como .env y llena tus datos
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=trazzo
# Base de datos en la nube (Aiven): conexión cifrada obligatoria. DB_CA_CERT = contenido de ca.pem (Aiven → Overview → CA certificate)
DB_SSL=
DB_CA_CERT=
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Seguimiento simulado: cada cuántos segundos avanzan los viajes (0 = apagado)
SIMULADOR_SEGUNDOS=10

# Asistente con IA (Claude). Crea tu clave en https://console.anthropic.com → API Keys
# Cada pregunta tiene costo por uso; sin clave, el resto de la app funciona igual.
ANTHROPIC_API_KEY=
# (Opcional) Solo si tu API key NO pertenece a un workspace: ID del workspace a usar (Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# (Opcional) Dirección pública del frontend para los enlaces/QR de rastreo.
# Si no se pone, se usa la IP de esta computadora en la red local (para escanear desde un celular en el mismo wifi).
PUBLIC_URL=
# Tráfico en vivo (TomTom, plan gratis). Crea tu clave en https://developer.tomtom.com → Dashboard
TOMTOM_API_KEY=
# Notificaciones push (Web Push). Genera el par de claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto del responsable para los servicios push (mailto: o https:)
VAPID_SUBJECT=mailto:tu@correo.mx
# IA del chat y del rastreo: gemini o claude (si no se indica: Gemini cuando hay GEMINI_API_KEY)
IA_PROVEEDOR=gemini
# Google Gemini (plan gratis). Crea tu clave en https://aistudio.google.com → Get API key
# En el plan gratis Google puede usar lo que se envía para mejorar sus productos: no mandes datos sensibles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
