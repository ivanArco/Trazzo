# Copia este archivo como .env y llena tus datos
PORT=3000
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=trazzo
# Requerir TLS para conexiones MySQL remotas (por ejemplo, Aiven)
DB_SSL=
# Ruta local del certificado CA de MySQL (Aiven lo descarga desde su consola)
DB_SSL_CA=
# Solo pruebas temporales sin CA: cifra la conexión, pero no verifica la identidad del servidor
DB_SSL_VERIFY=true
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
# Seguimiento simulado: cada cuántos segundos avanzan los viajes (0 = apagado)
SIMULADOR_SEGUNDOS=10
# ETA predictivo de rutas: velocidad promedio del camión y factor de restricciones (1 = sin demora extra)
VELOCIDAD_PROMEDIO_CAMION_KMH=65
FACTOR_RESTRICCION_RUTA=1

# Asistente con IA (Claude). Crea tu clave en https://console.anthropic.com → API Keys
# Cada pregunta tiene costo por uso; sin clave, el resto de la app funciona igual.
ANTHROPIC_API_KEY=
# (Opcional) Solo si tu API key NO pertenece a un workspace: ID del workspace a usar (Settings → Workspaces)
ANTHROPIC_WORKSPACE_ID=
# (Opcional) Dirección pública del frontend para los enlaces/QR de rastreo.
# Si no se pone, se usa la IP de esta computadora en la red local (para escanear desde un celular en el mismo wifi).
PUBLIC_URL=
